{
  "name": "dejavu",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "dev": "pnpm --filter blog dev",
    "build": "pnpm --filter blog build",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:oxlint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @dejavu/contract exec tsc --noEmit && pnpm --filter blog exec tsc --noEmit",
    "test": "vitest run"
  },
  "prettier": "@github/prettier-config",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@github/prettier-config": "^0.0.6",
    "@next/eslint-plugin-next": "^16.4.6",
    "@primer/stylelint-config": "^13.6.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-primer-react": "^9.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "stylelint": "^16.26.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
